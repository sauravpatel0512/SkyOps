# Copy to .env and adjust. Never commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skyops
# Compose service name inside the Docker network; use localhost from the host.
POSTGRES_HOST=postgres
# Host-published port is 5433 (see docker-compose). Inside containers use 5432.
POSTGRES_PORT=5433
# Local Docker Postgres: disable. Managed Postgres: require / verify-full.
POSTGRES_SSLMODE=disable

# --- Optional: managed Postgres (Neon / AWS RDS / Cloud SQL) for dbt --target cloud ---
# Create an empty DB, apply sql/*.sql (or let dbt create analytics schema), then:
#   make dbt-cloud
# Prefer a small fixture/sample load first — do not push 7M rows to free tiers by default.
# CLOUD_POSTGRES_HOST=ep-xxxx.us-east-2.aws.neon.tech
# CLOUD_POSTGRES_PORT=5432
# CLOUD_POSTGRES_USER=skyops
# CLOUD_POSTGRES_PASSWORD=
# CLOUD_POSTGRES_DB=skyops
# CLOUD_POSTGRES_SSLMODE=require

AIRFLOW_UID=50000
AIRFLOW_GID=0

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

AIRFLOW__CORE__FERNET_KEY=46BKJoajOgAWDugFLpSwqENwu0fSsTS_KHfdIuDUwuU=

# Demo year for BTS monthly downloads
SKYOPS_YEAR=2024

DBT_PROFILES_DIR=/opt/airflow/dbt
